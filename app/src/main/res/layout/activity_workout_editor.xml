<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#FFFFFF">

    <EditText
        android:id="@+id/etWorkoutTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Workout Title (e.g. Chest)"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginBottom="10dp"/>

    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/etWorkoutTitle"
        android:orientation="horizontal"
        android:background="#EEEEEE"
        android:padding="8dp">

        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5" android:text="Exercise" android:textStyle="bold" android:textSize="12sp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.6" android:text="Sets" android:gravity="center" android:textStyle="bold" android:textSize="12sp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:text="Range" android:gravity="center" android:textStyle="bold" android:textSize="12sp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.7" android:text="Done" android:gravity="center" android:textStyle="bold" android:textSize="12sp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.7" android:text="kg" android:gravity="center" android:textStyle="bold" android:textSize="12sp"/>

        <View android:layout_width="24dp" android:layout_height="match_parent"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvExerciseTable"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/llHeader"
        android:layout_above="@id/btnAddExercise"
        android:layout_marginTop="5dp" />

    <Button
        android:id="@+id/btnAddExercise"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/btnSaveWorkout"
        android:layout_centerHorizontal="true"
        android:text="+ Add Exercise"
        android:layout_marginBottom="10dp"
        android:backgroundTint="#4CAF50"/>

    <Button
        android:id="@+id/btnSaveWorkout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:text="Save Workout"
        android:backgroundTint="#2196F3"/>
</RelativeLayout>